{
  "name": "firered-phaser",
  "version": "1.0.0",
  "scripts": {
    "extract": "python3 tools/extract.py",
    "dev": "vite",
    "dev:battle": "vite --open /battle-test.html",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p tests",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run"
  },
  "description": "FireRed rebuilt in Phaser, with assets extracted from a local pret/firered decomp",
  "dependencies": {
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.4"
  },
  "private": true,
  "type": "module"
}
